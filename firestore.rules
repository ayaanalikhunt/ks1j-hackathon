rules_version = '2';
// Firestore is the enforcement layer. Money never moves on the client:
// donations/repayments are created `pending`; only the Admin SDK (Cloud Functions,
// after gateway confirmation) may set `paid`. Ledgers are append-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function role() { return signedIn() ? me().role : 'none'; }
    // Roles: member < volunteer < verifier/trustee < admin < super_admin < owner.
    // Staff may see beneficiary detail. Volunteers are NOT staff: community moderation and
    // announcements only, no access to cases, loans, members or ledgers.
    function isStaff() { return role() in ['verifier', 'trustee', 'admin', 'super_admin', 'owner']; }
    function isAdmin() { return role() in ['admin', 'super_admin', 'owner']; }
    function isMod() { return isStaff() || role() == 'volunteer'; }
    // Only the owner may touch owner/super_admin; a super_admin assigns everything below that.
    function canSetRole() {
      return role() == 'owner'
        || (role() == 'super_admin'
            && !(request.resource.data.role in ['owner', 'super_admin'])
            && !(resource.data.role in ['owner', 'super_admin']));
    }
    function unchanged(f) { return request.resource.data[f] == resource.data[f]; }

    // ---- members: own doc readable; role/sadaat flag staff-only ----
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.sadaatVerified == false;
      allow update: if signedIn() && request.auth.uid == uid
        && unchanged('role') && unchanged('sadaatVerified');
      allow update: if isAdmin() && unchanged('role'); // e.g. verify Sadaat status
      allow update: if canSetRole();
    }

    // ---- cases: applicant + staff only. Public cards come from publicCases (no PII). ----
    match /cases/{id} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted']
        && !('verifiedBy' in request.resource.data) && !('approvedBy' in request.resource.data)
        && request.resource.data.get('beneficiarySadaatVerified', false) == false; // staff-only flag
      // applicant may edit own draft only
      allow update: if signedIn() && resource.data.applicantId == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'applicantId', 'verifiedBy', 'verifiedAt', 'approvedBy', 'approvedAt', 'declinedBy', 'declinedAt',
             'declineReason', 'declineNote', 'disbursedBy', 'disbursedAt', 'beneficiarySadaatVerified']);
      // Each staff transition may touch only the fields it owns.
      // Rule 1: whoever verifies is never the person who approves.
      allow update: if (role() == 'verifier' || isAdmin()) && resource.data.status == 'submitted'
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedBy', 'verifiedAt', 'beneficiarySadaatVerified', 'sadaatCheckedBy']);
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status == 'verified'
        && request.resource.data.status == 'approved'
        && resource.data.verifiedBy != request.auth.uid
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']);
      // Publish: a trustee or admin opens an approved case to donors.
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status == 'approved'
        && request.resource.data.status == 'published'
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedBy', 'publishedAt']);
      // Cancel/decline: any staff member, before payout, with a required reason.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved']
        && request.resource.data.status == 'declined'
        && request.resource.data.declinedBy == request.auth.uid
        && request.resource.data.declineReason in ['insufficient_information', 'missing_sources', 'insufficient_proof', 'other']
        && request.resource.data.declineNote is string && request.resource.data.declineNote.size() >= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedBy', 'declinedAt', 'declineReason', 'declineNote']);
      // Funded and paid-out are written only by the Cloud Functions (they also write the ledger).
      // Closing a paid-out case is admin level.
      allow update: if isAdmin() && resource.data.status == 'disbursed'
        && request.resource.data.status == 'closed'
        && request.resource.data.closedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedBy', 'closedAt']);
      // Sadaat status is staff-only and is set before payout.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['beneficiarySadaatVerified']);
      match /documents/{docId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/cases/$(id)).data.applicantId == request.auth.uid || isStaff());
        // Proof photos: the applicant adds them while the case is still open. Compressed images only.
        allow create: if signedIn()
          && get(/databases/$(database)/documents/cases/$(id)).data.applicantId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(id)).data.status in ['draft', 'submitted', 'verified', 'approved']
          && request.resource.data.kind in ['aadhaar', 'address_proof', 'income_proof', 'fee_receipt', 'mark_sheet', 'medical_report', 'other']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt']);
        // Staff can add a document the family brought to the office, and say who added it.
        allow create: if isStaff()
          && get(/databases/$(database)/documents/cases/$(id)).data.status in ['submitted', 'verified', 'approved']
          && request.resource.data.kind in ['aadhaar', 'address_proof', 'income_proof', 'fee_receipt', 'mark_sheet', 'medical_report', 'other']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt', 'addedBy']);
        // AI check may only flag/suggest (server-written); no client may set a decision.
        allow update, delete: if false;
      }
    }

    // ---- public case cards: PII-free projection, server-written, world-readable ----
    // Written by an admin only, and only these PII-free keys.
    match /publicCases/{id} {
      allow read: if true;
      allow create, update: if (role() == 'trustee' || isAdmin())
        && request.resource.data.keys().hasOnly(['category', 'type', 'number', 'title', 'sadaat', 'description', 'amountNeeded', 'amountRaised', 'caseId']);
      allow delete: if role() == 'trustee' || isAdmin();
    }

    // ---- case history and the applicant's "Updates for you" feed. Append-only. ----
    match /caseEvents/{id} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.kind in ['submitted', 'verified', 'approved', 'published', 'funded', 'paid_out', 'closed', 'declined', 'document_added', 'gift_received']
        && request.resource.data.keys().hasOnly(['caseId', 'applicantId', 'caseNumber', 'caseTitle', 'kind', 'actorId', 'note', 'at'])
        && (isStaff() || (request.resource.data.kind in ['submitted', 'document_added'] && request.resource.data.applicantId == request.auth.uid));
      allow update, delete: if false;
    }

    // ---- case numbers: a counter that can only go up by one ----
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'cases' && request.resource.data.n == 1 && request.resource.data.keys().hasOnly(['n']);
      allow update: if signedIn() && id == 'cases' && request.resource.data.n == resource.data.n + 1 && request.resource.data.keys().hasOnly(['n']);
    }
    match /publicStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- institutions ----
    match /institutions/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // ---- donations: create pending only; fund separation (rule 2) ----
    match /donations/{id} {
      allow read: if signedIn() && (resource.data.payerId == request.auth.uid || isStaff());
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && (request.resource.data.fund in ['sehme_sadaat', 'general']
            ? (request.resource.data.caseId is string && !('institutionId' in request.resource.data)
               && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.status == 'published')
            : (request.resource.data.fund == 'sehme_imam'
               && request.resource.data.institutionId is string && !('caseId' in request.resource.data)))
        && (request.resource.data.fund != 'sehme_sadaat'
            || get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.beneficiarySadaatVerified == true)
        && (request.resource.data.fund != 'sehme_imam'
            || get(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ijazahVerified == true)
        && (request.resource.data.payerId == null || request.resource.data.payerId == request.auth.uid);
      allow update, delete: if false; // `paid` flip is Admin-SDK only
    }

    // ---- Khums / Lawajam ----
    match /khumsCalculations/{id} {
      allow read: if signedIn() && (resource.data.memberId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.memberId == request.auth.uid;
    }
    match /lawajamRecords/{id} {
      allow read: if signedIn() && (resource.data.memberId == request.auth.uid || isStaff());
      allow write: if isAdmin();
    }

    // ---- loans: no interest field exists, by construction ----
    match /loans/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'applied'
        && !('interest' in request.resource.data) && !('lateFee' in request.resource.data);
      // Disbursement requires prior two-sided EMI agreement.
      allow update: if (role() == 'trustee' || isAdmin())
        && (request.resource.data.status != 'disbursed'
            || (resource.data.status == 'agreed' && resource.data.familyAccepted == true && resource.data.trusteeAccepted == true))
        && !('interest' in request.resource.data) && !('lateFee' in request.resource.data);
      allow update: if signedIn() && resource.data.borrowerId == request.auth.uid
        && resource.data.status == 'emi_pending_agreement'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyAccepted', 'status']);
    }
    match /repayments/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // ---- ledger: append-only, written by the Admin SDK only ----
    match /ledger/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- helpdesk KB + announcements ----
    match /kbDocuments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isMod();
    }

    // ---- community ----
    function hasProfile() { return exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)); }
    function conn(cid) { return get(/databases/$(database)/documents/communityConnections/$(cid)).data; }

    match /communityProfiles/{uid} {
      allow read: if signedIn() && hasProfile() && (resource.data.listed == true || request.auth.uid == uid || isMod());
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow update: if isMod(); // moderation
    }
    match /communityPosts/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.authorId == request.auth.uid;
      allow update: if isMod(); // moderation (remove/restore)
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /appreciations/{uid} {
        allow read: if signedIn() && hasProfile();
        allow create, delete: if signedIn() && hasProfile() && request.auth.uid == uid;
      }
    }
    match /communityOpportunities/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.authorId == request.auth.uid;
      allow update: if isMod();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /communityGroups/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMod() || (signedIn() && resource.data.ownerId == request.auth.uid);
      match /members/{uid} {
        // roster visible only to members of that group (and staff)
        allow read: if signedIn() && (isMod() || request.auth.uid == uid
          || exists(/databases/$(database)/documents/communityGroups/$(id)/members/$(request.auth.uid)));
        allow create: if signedIn() && hasProfile() && request.auth.uid == uid
          && request.resource.data.role == 'member'
          && request.resource.data.status == (get(/databases/$(database)/documents/communityGroups/$(id)).data.private == true ? 'pending' : 'member');
        // the group's creator seeds their own owner row
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/communityGroups/$(id)).data.ownerId == uid;
        // owner approves pending requests
        allow update: if signedIn() && get(/databases/$(database)/documents/communityGroups/$(id)).data.ownerId == request.auth.uid;
        // members may leave; owner may not (no transfer flow)
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.role != 'owner';
      }
    }
    // Consent-gated: messages only on ACCEPTED connections, only by the two participants.
    match /communityConnections/{id} {
      allow read: if signedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() && hasProfile() && request.resource.data.fromId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['message', 'call']
        && request.resource.data.note is string && request.resource.data.note.size() > 0;
      allow update: if signedIn() && resource.data.toId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      match /messages/{mid} {
        allow read: if signedIn() && conn(id).status == 'accepted'
          && (conn(id).fromId == request.auth.uid || conn(id).toId == request.auth.uid);
        allow create: if signedIn() && conn(id).status == 'accepted'
          && (conn(id).fromId == request.auth.uid || conn(id).toId == request.auth.uid)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /communityReports/{id} {
      allow create: if signedIn() && hasProfile() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update: if isMod();
    }
  }
}
