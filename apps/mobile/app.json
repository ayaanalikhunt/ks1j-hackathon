{
  "expo": {
    "name": "KS1J",
    "slug": "ks1j",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ks1j.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "scheme": [
      "ks1j",
      "com.googleusercontent.apps.874901866220-s5of9flkm468fq0fc717k4e8loc14stn"
    ],
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KS1J uses your photos only to attach proof documents to your application.",
          "cameraPermission": "KS1J uses the camera only to photograph proof documents for your application."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/member"
    }
  }
}
