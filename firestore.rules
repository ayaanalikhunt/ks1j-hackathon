rules_version = '2';
// Firestore is the enforcement layer. Money never moves on the client:
// donations/repayments are created `pending`; only the Admin SDK (Cloud Functions,
// after gateway confirmation) may set `paid`. Ledgers are append-only.
service cloud.firestore {
  match /databases/{database}/documents {

    function validDonor(d) {
      return d.keys().hasOnly(['donorId', 'fullName', 'displayName', 'email', 'phone', 'country', 'preferredCurrency', 'notifications', 'createdAt', 'updatedAt'])
        && d.donorId == request.auth.uid
        && d.updatedAt == request.time
        && d.get('fullName', '') is string && d.get('fullName', '').size() <= 80
        && d.get('displayName', '') is string && d.get('displayName', '').size() <= 60
        && d.get('email', '') is string && d.get('email', '').size() <= 120
        && d.get('phone', '') is string && d.get('phone', '').size() <= 25
        && d.get('country', '') is string && d.get('country', '').size() <= 60
        && d.get('preferredCurrency', 'INR') in ['INR', 'USD', 'EUR', 'GBP', 'AED', 'SAR', 'CAD', 'AUD', 'SGD', 'QAR', 'KWD']
        && d.get('notifications', {}).keys().hasOnly(['received', 'allocated', 'disbursed', 'refunded', 'completed'])
        && d.get('notifications', {}).values().hasOnly([true, false]);
    }
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
    function role() { return signedIn() ? me().role : 'none'; }
    // Roles: member < volunteer < verifier/trustee < admin < super_admin < owner.
    // Staff may see beneficiary detail. Volunteers are NOT staff: community moderation and
    // announcements only, no access to cases, loans, members or ledgers.
    function isStaff() { return role() in ['verifier', 'trustee', 'admin', 'super_admin', 'owner']; }
    function isAdmin() { return role() in ['admin', 'super_admin', 'owner']; }
    function isMod() { return isStaff() || role() == 'volunteer'; }
    // Only the owner may touch owner/super_admin; a super_admin assigns everything below that.
    function canSetRole() {
      return role() == 'owner'
        || (role() == 'super_admin'
            && !(request.resource.data.role in ['owner', 'super_admin'])
            && !(resource.data.role in ['owner', 'super_admin']));
    }
    function unchanged(f) { return request.resource.data[f] == resource.data[f]; }

    // ---- members: own doc readable; role/sadaat flag staff-only ----
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member'
        && request.resource.data.sadaatVerified == false
        && request.resource.data.get('membershipVerified', false) == false
        && !('householdId' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && unchanged('role') && unchanged('sadaatVerified')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['householdId', 'membershipVerified']);
      // Admins verify Sadaat status and link a member to their household. They cannot change roles here.
      allow update: if isAdmin() && unchanged('role');
      allow update: if canSetRole();
    }

    // ---- cases: applicant + staff only. Public cards come from publicCases (no PII). ----
    match /cases/{id} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.status in ['draft', 'submitted']
        && !('verifiedBy' in request.resource.data) && !('approvedBy' in request.resource.data)
        && request.resource.data.get('beneficiarySadaatVerified', false) == false // staff-only flag
        // Identity proof: "none" is a legitimate answer, but it needs a reason. Everything the committee decides stays staff-only.
        && request.resource.data.get('idProofType', 'aadhaar') in ['aadhaar', 'pan', 'passport', 'driving_licence', 'voter_id', 'ration_card', 'other', 'none']
        && (request.resource.data.get('idProofType', 'aadhaar') != 'none' || request.resource.data.get('noIdReason', '') in ['no_government_id', 'document_lost', 'minor', 'emergency', 'displaced', 'privacy', 'unable_to_obtain', 'other'])
        && request.resource.data.get('verificationStatus', 'pending_review') == 'pending_review'
        && request.resource.data.get('priority', 'normal') == 'normal'
        && !('emergencyException' in request.resource.data) && !('verificationMethod' in request.resource.data)
        && !('zakatEligible' in request.resource.data) && !('khumsEligible' in request.resource.data)
        && request.resource.data.get('publicCaseId', 'CASE-2000-000000').matches('^CASE-20[0-9][0-9]-[0-9]{6}$');
      // applicant may edit own draft only
      allow update: if signedIn() && resource.data.applicantId == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'applicantId', 'verifiedBy', 'verifiedAt', 'approvedBy', 'approvedAt', 'declinedBy', 'declinedAt',
             'declineReason', 'declineNote', 'disbursedBy', 'disbursedAt', 'beneficiarySadaatVerified',
             'priority', 'emergencyException', 'verificationMethod', 'verificationNotes', 'verificationBy', 'verificationAt',
             'verificationStatus', 'zakatEligible', 'khumsEligible', 'publicCaseId']);
      // Each staff transition may touch only the fields it owns.
      // Rule 1: whoever verifies is never the person who approves.
      allow update: if (role() == 'verifier' || isAdmin()) && resource.data.status == 'submitted'
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedBy', 'verifiedAt', 'beneficiarySadaatVerified', 'sadaatCheckedBy']);
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status == 'verified'
        && request.resource.data.status == 'approved'
        && resource.data.verifiedBy != request.auth.uid
        // No ID is not a rejection, but it must be cleared another way (or by a recorded emergency exception) before approval.
        && (resource.data.get('idProofType', 'aadhaar') != 'none'
            || resource.data.get('emergencyException', null) != null
            || resource.data.get('verificationMethod', 'none_available') != 'none_available')
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedBy', 'approvedAt']);
      // Publish: a trustee or admin opens an approved case to donors.
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status == 'approved'
        && request.resource.data.status == 'published'
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'publishedBy', 'publishedAt']);
      // Cancel/decline: any staff member, before payout, with a required reason.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved']
        && request.resource.data.status == 'declined'
        && request.resource.data.declinedBy == request.auth.uid
        && request.resource.data.declineReason in ['insufficient_information', 'missing_sources', 'insufficient_proof', 'other']
        && request.resource.data.declineNote is string && request.resource.data.declineNote.size() >= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedBy', 'declinedAt', 'declineReason', 'declineNote']);
      // Funded, paid-out and closed are written only by the Cloud Functions (payOutCase, closeCase): paying out writes
      // the ledger, and closing tells the donors the case is complete.
      // Alternative verification for someone with no ID proof.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved']
        && resource.data.get('idProofType', 'aadhaar') == 'none'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationMethod', 'verificationNotes', 'verificationBy', 'verificationAt', 'verificationStatus'])
        && request.resource.data.verificationMethod in ['committee_interview', 'home_visit', 'authorized_representative', 'reference_check', 'institution_document', 'school_verification', 'hospital_verification', 'local_organization', 'other', 'none_available']
        && request.resource.data.verificationBy == request.auth.uid
        && request.resource.data.verificationStatus in ['pending_review', 'verified', 'rejected'];
      // Priority and the need category are the committee's call.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved', 'published']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['priority', 'needCategory'])
        && request.resource.data.get('priority', 'normal') in ['low', 'normal', 'high', 'urgent']
        && request.resource.data.get('needCategory', 'other') is string;
      // Emergency exception: a trustee or admin approves it, with a reason. It speeds the review; it removes no financial control.
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status in ['submitted', 'verified', 'approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emergencyException', 'priority'])
        && request.resource.data.emergencyException.keys().hasOnly(['reason', 'approvedBy', 'at'])
        && request.resource.data.emergencyException.approvedBy == request.auth.uid
        && request.resource.data.emergencyException.reason is string && request.resource.data.emergencyException.reason.size() >= 5
        && request.resource.data.emergencyException.at == request.time
        && request.resource.data.get('priority', 'urgent') in ['high', 'urgent'];
      // Which restricted funds a case may receive is a committee determination.
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.status in ['submitted', 'verified', 'approved', 'published']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zakatEligible', 'khumsEligible'])
        && request.resource.data.get('zakatEligible', false) is bool && request.resource.data.get('khumsEligible', false) is bool;
      // Sadaat status is staff-only and is set before payout.
      allow update: if isStaff() && resource.data.status in ['submitted', 'verified', 'approved']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['beneficiarySadaatVerified']);
      match /documents/{docId} {
        allow read: if signedIn() && (get(/databases/$(database)/documents/cases/$(id)).data.applicantId == request.auth.uid || isStaff());
        // Proof photos: the applicant adds them while the case is still open. Compressed images only.
        allow create: if signedIn()
          && get(/databases/$(database)/documents/cases/$(id)).data.applicantId == request.auth.uid
          && get(/databases/$(database)/documents/cases/$(id)).data.status in ['draft', 'submitted', 'verified', 'approved']
          && request.resource.data.kind in ['aadhaar', 'address_proof', 'income_proof', 'fee_receipt', 'mark_sheet', 'medical_report', 'pan', 'passport', 'driving_licence', 'voter_id', 'ration_card', 'other']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt']);
        // Staff can add a document the family brought to the office, and say who added it.
        allow create: if isStaff()
          && get(/databases/$(database)/documents/cases/$(id)).data.status in ['submitted', 'verified', 'approved']
          && request.resource.data.kind in ['aadhaar', 'address_proof', 'income_proof', 'fee_receipt', 'mark_sheet', 'medical_report', 'pan', 'passport', 'driving_licence', 'voter_id', 'ration_card', 'other']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt', 'addedBy']);
        // AI check may only flag/suggest (server-written); no client may set a decision.
        allow update, delete: if false;
      }
    }

    // ---- need categories: a built-in list lives in the apps; the committee can add more here ----
    match /caseCategories/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['label', 'active', 'createdBy'])
        && request.resource.data.label is string && request.resource.data.label.size() >= 2 && request.resource.data.label.size() <= 40;
      allow delete: if isAdmin();
    }

    // ---- public case cards: PII-free projection, server-written, world-readable ----
    // Written by an admin only, and only these PII-free keys.
    match /publicCases/{id} {
      allow read: if true;
      allow create, update: if (role() == 'trustee' || isAdmin())
        && request.resource.data.keys().hasOnly(['category', 'type', 'number', 'title', 'sadaat', 'description', 'amountNeeded', 'amountRaised', 'caseId', 'publicCaseId', 'needCategory', 'priority', 'emergency']);
      allow delete: if role() == 'trustee' || isAdmin();
    }

    // ---- case history and the applicant's "Updates for you" feed. Append-only. ----
    match /caseEvents/{id} {
      allow read: if signedIn() && (resource.data.applicantId == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.kind in ['submitted', 'verified', 'approved', 'published', 'funded', 'paid_out', 'closed', 'declined', 'document_added', 'gift_received']
        && request.resource.data.keys().hasOnly(['caseId', 'applicantId', 'caseNumber', 'caseTitle', 'kind', 'actorId', 'note', 'at'])
        && (isStaff() || (request.resource.data.kind in ['submitted', 'document_added'] && request.resource.data.applicantId == request.auth.uid));
      allow update, delete: if false;
    }

    // ---- case numbers: a counter that can only go up by one ----
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == 'cases' && request.resource.data.n == 1 && request.resource.data.keys().hasOnly(['n']);
      allow update: if signedIn() && id == 'cases' && request.resource.data.n == resource.data.n + 1 && request.resource.data.keys().hasOnly(['n']);
    }
    match /publicStats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- institutions ----
    // `received` and `handedOver` are written only by the Cloud Functions, so the held balance cannot be faked.
    // Sehme Imam goes only to institutions holding an ijazah from a Marja'. One trustee adds one, a DIFFERENT trustee
    // verifies it. Until then it is hidden from members.
    match /institutions/{id} {
      allow read: if resource.data.ijazahVerified == true || isStaff();
      allow create: if (role() == 'trustee' || isAdmin())
        && request.resource.data.ijazahVerified == false
        && request.resource.data.addedBy == request.auth.uid
        && !('received' in request.resource.data) && !('handedOver' in request.resource.data)
        && !('verifiedBy' in request.resource.data);
      allow update: if (role() == 'trustee' || isAdmin()) && resource.data.ijazahVerified == false
        && request.resource.data.ijazahVerified == true
        && resource.data.addedBy != request.auth.uid
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ijazahVerified', 'verifiedBy', 'verifiedAt']);
      // Other edits (name, city, pausing gifts). Never the money fields, the verification, or who added it.
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['received', 'handedOver', 'ijazahVerified', 'verifiedBy', 'verifiedAt', 'addedBy']);
      match /documents/{docId} {
        allow read: if isStaff();
        allow create: if (role() == 'trustee' || isAdmin())
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt', 'addedBy'])
          && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- fraud flags: computed from the cases, so only the human decision is stored. A flag is a question, not a verdict. ----
    match /fraudFlags/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.status in ['clear', 'confirmed']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.kind in ['same_applicant', 'same_household']
        && request.resource.data.keys().hasOnly(['caseId', 'otherId', 'kind', 'status', 'by', 'at']);
      allow delete: if false;
    }
    match /handovers/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- households: Lawajam is due per household ----
    match /households/{id} {
      allow read: if signedIn() && (isStaff() || me().get('householdId', '') == id);
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['name', 'area', 'address', 'createdBy', 'createdAt', 'memberNames']);
    }

    // ---- donations: create pending only; fund separation (rule 2) ----
    match /donations/{id} {
      allow read: if signedIn() && (resource.data.payerId == request.auth.uid || isStaff());
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && (request.resource.data.fund in ['sehme_sadaat', 'general']
            ? (request.resource.data.caseId is string && !('institutionId' in request.resource.data)
               && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.status == 'published')
            : (request.resource.data.fund == 'sehme_imam'
               && request.resource.data.institutionId is string && !('caseId' in request.resource.data)))
        && (request.resource.data.fund != 'sehme_sadaat'
            || get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.beneficiarySadaatVerified == true)
        && (request.resource.data.fund != 'sehme_imam'
            || get(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ijazahVerified == true)
        && (request.resource.data.payerId == null || request.resource.data.payerId == request.auth.uid);
      allow update, delete: if false; // `paid` flip is Admin-SDK only
    }

    // ---- Khums / Lawajam ----
    match /khumsCalculations/{id} {
      allow read: if signedIn() && (resource.data.memberId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.memberId == request.auth.uid;
    }
    // One due per household per year. The document id is "<householdId>_<year>", so raising it twice cannot duplicate it.
    match /lawajamRecords/{id} {
      allow read: if signedIn() && (isStaff() || me().get('householdId', '') == resource.data.householdId);
      allow create: if isAdmin()
        && id == request.resource.data.householdId + '_' + request.resource.data.year
        && request.resource.data.status == 'due'
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.year.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['householdId', 'householdName', 'area', 'year', 'amount', 'status', 'createdAt', 'createdBy']);
      allow update, delete: if false; // paid is set by the Cloud Function when a payment is confirmed
    }
    // A household member pays their household's due. Created pending; only the function confirms it.
    match /lawajamPayments/{id} {
      allow read: if signedIn() && (resource.data.payerId == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.payerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.householdId == me().get('householdId', '')
        && request.resource.data.recordId == request.resource.data.householdId + '_' + request.resource.data.year
        && get(/databases/$(database)/documents/lawajamRecords/$(request.resource.data.recordId)).data.status == 'due'
        && request.resource.data.amount == get(/databases/$(database)/documents/lawajamRecords/$(request.resource.data.recordId)).data.amount
        && request.resource.data.keys().hasOnly(['recordId', 'householdId', 'year', 'amount', 'payerId', 'status', 'createdAt']);
      allow update, delete: if false;
    }

    // ---- loans (Qard-e-Hasana) ----
    // No interest or late fee can be stored: every write is an allowlist of keys, and none of them is a rate or a fee.
    // A plan can only be proposed after the background checks exist, and for an orphan loan only after a home visit by
    // someone other than the person approving it. Disbursement, repayment and hardship decisions are Cloud Functions.
    function loanOf(lid) { return get(/databases/$(database)/documents/loans/$(lid)).data; }
    function hasCheck(lid, k) { return exists(/databases/$(database)/documents/loans/$(lid)/checks/$(k)); }
    function basicChecksDone(lid) {
      return hasCheck(lid, 'identity') && hasCheck(lid, 'address') && hasCheck(lid, 'income') && hasCheck(lid, 'institution_fee');
    }
    // Firestore allows 10 document lookups per rule evaluation, so the home visit is read once (a missing one fails the rule),
    // not checked with exists() and then read again.
    function orphanChecksDone(lid) {
      let visit = get(/databases/$(database)/documents/loans/$(lid)/checks/home_visit).data;
      return hasCheck(lid, 'orphan_status') && hasCheck(lid, 'guardian') && hasCheck(lid, 'references') && hasCheck(lid, 'no_other_loans')
        && visit.by != request.auth.uid && visit.recommend == true;
    }
    function trusteeOrAdmin() { return role() == 'trustee' || isAdmin(); }
    // The monthly amount must repay the loan within 48 months.
    function emiOk(v, principal) { return v is int && v * 48 >= principal; }

    match /loans/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'applied'
        && request.resource.data.principal is int && request.resource.data.principal > 0
        && request.resource.data.courseEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.orphan is bool
        && request.resource.data.keys().hasOnly(['borrowerId', 'borrowerName', 'studentName', 'course', 'institution', 'courseEnd',
             'principal', 'purpose', 'orphan', 'parentStatus', 'guardianName', 'guardianRelation', 'guardianPhone', 'guardianAddress',
             'guardianOccupation', 'guardianIncome', 'guarantorName', 'guarantorPhone', 'guarantorRelation', 'refs', 'status', 'createdAt'])
        && (request.resource.data.orphan == false
            || (request.resource.data.refs is list && request.resource.data.refs.size() >= 2
                && request.resource.data.get('guardianName', '') != '' && request.resource.data.get('parentStatus', '') != ''));

      // The committee accepts the application and proposes a monthly amount. Needs every check, and for an orphan loan a home visit.
      allow update: if trusteeOrAdmin() && resource.data.status == 'applied'
        && request.resource.data.status == 'emi_pending_agreement'
        && basicChecksDone(id) && (resource.data.orphan == false || orphanChecksDone(id))
        && request.resource.data.reviewedBy == request.auth.uid
        && emiOk(request.resource.data.trusteeEmi, resource.data.principal)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'trusteeEmi', 'reviewedBy', 'reviewedAt']);
      allow update: if trusteeOrAdmin() && resource.data.status in ['applied', 'emi_pending_agreement']
        && request.resource.data.status == 'declined'
        && request.resource.data.declinedBy == request.auth.uid
        && request.resource.data.declineNote is string && request.resource.data.declineNote.size() >= 5
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'declinedBy', 'declineNote', 'declinedAt']);
      // The family proposes its own monthly amount; the trustee may suggest another. The plan is agreed when both match.
      allow update: if signedIn() && resource.data.borrowerId == request.auth.uid && resource.data.status == 'emi_pending_agreement'
        && emiOk(request.resource.data.familyEmi, resource.data.principal)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['familyEmi']);
      allow update: if trusteeOrAdmin() && resource.data.status == 'emi_pending_agreement'
        && emiOk(request.resource.data.trusteeEmi, resource.data.principal)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trusteeEmi']);
      allow update: if trusteeOrAdmin() && resource.data.status == 'emi_pending_agreement'
        && resource.data.get('familyEmi', 0) > 0 && resource.data.get('familyEmi', 0) == resource.data.get('trusteeEmi', -1)
        && request.resource.data.status == 'agreed' && request.resource.data.emi == resource.data.familyEmi
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'emi', 'agreedAt']);

      // Background checks: one document per check, written once by the person who did it. Never edited or removed.
      match /checks/{key} {
        allow read: if isStaff();
        allow create: if isStaff() && loanOf(id).status == 'applied'
          && key in ['identity', 'address', 'income', 'institution_fee', 'orphan_status', 'guardian', 'references', 'no_other_loans', 'home_visit']
          && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'at', 'note', 'recommend', 'report', 'date'])
          && (key != 'home_visit'
              || (request.resource.data.recommend is bool && request.resource.data.report is string
                  && request.resource.data.report.size() >= 20 && request.resource.data.date is string));
        allow update, delete: if false;
      }
      // Proof photos, as for cases. The family and staff can add them while the application is being checked.
      match /documents/{docId} {
        allow read: if signedIn() && (loanOf(id).borrowerId == request.auth.uid || isStaff());
        allow create: if signedIn() && loanOf(id).status == 'applied'
          && (loanOf(id).borrowerId == request.auth.uid || isStaff())
          && request.resource.data.kind in ['aadhaar', 'address_proof', 'income_proof', 'admission_letter', 'fee_structure', 'mark_sheet', 'death_certificate', 'guardian_id', 'other']
          && request.resource.data.dataUrl is string
          && request.resource.data.dataUrl.matches('^data:image/(jpeg|png);base64,.*')
          && request.resource.data.dataUrl.size() < 900000
          && request.resource.data.keys().hasOnly(['kind', 'name', 'dataUrl', 'uploadedAt', 'addedBy'])
          && (!('addedBy' in request.resource.data) || request.resource.data.addedBy == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // A repayment is created pending by the borrower. Only the Cloud Function marks it paid and moves the schedule.
    match /repayments/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.keys().hasOnly(['loanId', 'borrowerId', 'amount', 'status', 'createdAt'])
        && loanOf(request.resource.data.loanId).borrowerId == request.auth.uid
        && loanOf(request.resource.data.loanId).status in ['disbursed', 'repaying'];
      allow update, delete: if false;
    }

    // Hardship: a family that cannot pay asks for a pause or a lower amount. Reminders stop until a trustee decides (a function).
    match /hardships/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid || isStaff());
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.type in ['pause', 'lower']
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 10
        && (request.resource.data.type == 'pause'
            ? (request.resource.data.months is int && request.resource.data.months >= 1 && request.resource.data.months <= 6)
            : (request.resource.data.newEmi is int && request.resource.data.newEmi > 0))
        && (!('proofDataUrl' in request.resource.data) || request.resource.data.proofDataUrl.size() < 900000)
        && request.resource.data.keys().hasOnly(['loanId', 'borrowerId', 'type', 'months', 'newEmi', 'reason', 'proofDataUrl', 'status', 'createdAt'])
        && loanOf(request.resource.data.loanId).borrowerId == request.auth.uid
        && loanOf(request.resource.data.loanId).status in ['disbursed', 'repaying'];
      allow update, delete: if false;
    }

    // ---- ledger: append-only, written by the Admin SDK only ----
    match /ledger/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- payments: written only by the functions ----
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Donors read their own allocations and payouts. Recipient names and reference numbers sit in a staff-only subdocument.
    match /allocations/{id} {
      allow read: if signedIn() && (resource.data.donorId == request.auth.uid || isStaff());
      allow write: if false;
    }
    match /disbursements/{id} {
      allow read: if signedIn() && (resource.data.donorId == request.auth.uid || isStaff());
      allow write: if false;
      match /private/{doc} {
        allow read: if isStaff();
        allow write: if false;
      }
    }
    // A donor's own profile and notification choices. Only they edit it; committee staff can read it.
    match /donors/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isStaff());
      allow create: if signedIn() && uid == request.auth.uid && validDonor(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && uid == request.auth.uid && validDonor(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }
    match /payments/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.donorId == request.auth.uid);
      allow write: if false;
    }
    match /fxRates/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /webhookEvents/{id} {
      allow read, write: if false;
    }

    // ---- helpdesk KB + announcements ----
    match /kbDocuments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if isMod();
    }

    // ---- community ----
    function hasProfile() { return exists(/databases/$(database)/documents/communityProfiles/$(request.auth.uid)); }
    function conn(cid) { return get(/databases/$(database)/documents/communityConnections/$(cid)).data; }

    match /communityProfiles/{uid} {
      allow read: if signedIn() && hasProfile() && (resource.data.listed == true || request.auth.uid == uid || isMod());
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
      allow update: if isMod(); // moderation
    }
    match /communityPosts/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.authorId == request.auth.uid;
      allow update: if isMod(); // moderation (remove/restore)
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      match /appreciations/{uid} {
        allow read: if signedIn() && hasProfile();
        allow create, delete: if signedIn() && hasProfile() && request.auth.uid == uid;
      }
    }
    match /communityOpportunities/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.authorId == request.auth.uid;
      allow update: if isMod();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /communityGroups/{id} {
      allow read: if signedIn() && hasProfile();
      allow create: if signedIn() && hasProfile() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMod() || (signedIn() && resource.data.ownerId == request.auth.uid);
      match /members/{uid} {
        // roster visible only to members of that group (and staff)
        allow read: if signedIn() && (isMod() || request.auth.uid == uid
          || exists(/databases/$(database)/documents/communityGroups/$(id)/members/$(request.auth.uid)));
        allow create: if signedIn() && hasProfile() && request.auth.uid == uid
          && request.resource.data.role == 'member'
          && request.resource.data.status == (get(/databases/$(database)/documents/communityGroups/$(id)).data.private == true ? 'pending' : 'member');
        // the group's creator seeds their own owner row
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/communityGroups/$(id)).data.ownerId == uid;
        // owner approves pending requests
        allow update: if signedIn() && get(/databases/$(database)/documents/communityGroups/$(id)).data.ownerId == request.auth.uid;
        // members may leave; owner may not (no transfer flow)
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.role != 'owner';
      }
    }
    // Consent-gated: messages only on ACCEPTED connections, only by the two participants.
    match /communityConnections/{id} {
      allow read: if signedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() && hasProfile() && request.resource.data.fromId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['message', 'call']
        && request.resource.data.note is string && request.resource.data.note.size() > 0;
      allow update: if signedIn() && resource.data.toId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      match /messages/{mid} {
        allow read: if signedIn() && conn(id).status == 'accepted'
          && (conn(id).fromId == request.auth.uid || conn(id).toId == request.auth.uid);
        allow create: if signedIn() && conn(id).status == 'accepted'
          && (conn(id).fromId == request.auth.uid || conn(id).toId == request.auth.uid)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /communityReports/{id} {
      allow create: if signedIn() && hasProfile() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update: if isMod();
    }
  }
}
